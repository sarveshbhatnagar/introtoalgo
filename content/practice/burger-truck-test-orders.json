  "compare": "checker",
  "checker": [
    "function check(args, got, expected) {",
    "  const menu = args[0];",
    "  if (!Array.isArray(got)) return 'Return a list of selections.';",
    "  const seen = new Set();",
    "  for (const order of got) {",
    "    if (!Array.isArray(order)) return 'Each selection must be a list of topping names.';",
    "    for (const t of order) if (!menu.includes(t)) return 'Unknown topping ' + JSON.stringify(t) + '.';",
    "    if (new Set(order).size !== order.length) return 'A selection uses the same topping twice: ' + JSON.stringify(order);",
    "    const key = JSON.stringify([...order].sort());",
    "    if (seen.has(key)) return 'The same burger appears twice: ' + JSON.stringify(order);",
    "    seen.add(key);",
    "  }",
    "  if (got.length !== expected.length) return 'There are ' + expected.length + ' different burgers, but you returned ' + got.length + '.';",
    "  return true;",
    "}"
  ],
  "solution": {
    "js": [
      "function allOrders(toppings) {",
      "  const orders = [];",
      "  const current = []; // the burger being built",
      "  function choose(i) {",
      "    if (i === toppings.length) {",
      "      orders.push([...current]); // copy: current keeps changing",
      "      return;",
      "    }",
      "    choose(i + 1);               // burger without topping i",
      "    current.push(toppings[i]);",
      "    choose(i + 1);               // burger with topping i",
      "    current.pop();               // undo before going back up",
      "  }",
      "  choose(0);",
      "  return orders;",
      "}"
    ],
    "py": [
      "def all_orders(toppings):",
      "    orders = []",
      "    current = []  # the burger being built",
      "",
      "    def choose(i):",
      "        if i == len(toppings):",
      "            orders.append(current[:])  # copy: current keeps changing",
      "            return",
      "        choose(i + 1)                  # burger without topping i",
      "        current.append(toppings[i])",
      "        choose(i + 1)                  # burger with topping i",
      "        current.pop()                  # undo before going back up",
      "",
      "    choose(0)",
      "    return orders"
